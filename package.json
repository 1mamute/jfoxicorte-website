{
  "name": "jfoxicorte-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run images",
    "build": "next build",
    "prepreview": "npm run build",
    "preview": "serve out",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run images",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "images": "node scripts/images.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.54.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "serve": {
      "compression": "^1.8.2"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
